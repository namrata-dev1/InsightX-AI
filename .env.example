# InsightX AI - Environment Variables Template
# Copy this file to .env and configure local paths/keys

# Application & Logging
APP_ENV=development
LOG_LEVEL=INFO

# Paths
DATA_DIR=data
ARTIFACTS_DIR=artifacts

# Optional AI Insight Generation (e.g. OpenAI / Gemini API key if using LLM-assisted summaries)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
